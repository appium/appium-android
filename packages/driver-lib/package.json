{
  "name": "appium-android-driver",
  "version": "15.0.0",
  "description": "Android UiAutomator and Chrome support for Appium",
  "keywords": [
    "android",
    "appium",
    "automation",
    "mobile",
    "mobile testing",
    "testing"
  ],
  "homepage": "https://appium.io",
  "bugs": {
    "url": "https://github.com/appium/appium-android/issues"
  },
  "license": "Apache-2.0",
  "author": "Appium Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/appium/appium-android.git",
    "directory": "packages/driver-lib"
  },
  "bin": {},
  "directories": {
    "lib": "lib"
  },
  "files": [
    "lib",
    "build/lib",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./build/lib/index.js",
  "types": "./build/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/lib/index.d.ts",
      "import": "./build/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "npm run build -- --clean",
    "dev": "npm run build -- --watch",
    "prepare": "npm run build",
    "rebuild": "npm run clean && npm run build",
    "test": "node --enable-source-maps --experimental-test-module-mocks --test --test-force-exit --test-timeout=60000 \"./build/test/unit/**/*.spec.js\""
  },
  "dependencies": {
    "@appium/support": "^8.0.0-beta.3",
    "appium-adb": "^16.3.0",
    "appium-chromedriver": "^9.1.13",
    "asyncbox": "^6.4.3",
    "axios": "^1.18.0",
    "dayjs": "^1.11.21",
    "io.appium.settings": "^8.5.1",
    "lru-cache": "^11.1.0",
    "portscanner": "^2.2.0",
    "semver": "^7.0.0",
    "teen_process": "^4.2.0",
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "@appium/tsconfig": "^2.0.0-beta.1",
    "@appium/types": "^2.0.0-beta.3",
    "@types/node": "^26.0.0",
    "@types/portscanner": "^2.1.1",
    "@types/semver": "^7.5.0",
    "@types/sinon": "^22.0.0",
    "@types/ws": "^8.5.4",
    "sinon": "^22.0.0"
  },
  "peerDependencies": {
    "appium": "^4.0.0-beta.4"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=10"
  }
}
