{
  "name": "io.appium.settings",
  "version": "8.3.1",
  "description": "App for dealing with Android settings",
  "keywords": [
    "android",
    "appium",
    "settings"
  ],
  "homepage": "https://appium.io",
  "bugs": {
    "url": "https://github.com/appium/appium-android/issues"
  },
  "license": "Apache-2.0",
  "author": "Appium Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/appium/appium-android.git",
    "directory": "packages/settings"
  },
  "files": [
    "lib",
    "build/lib",
    "apks",
    "!.DS_Store",
    "NOTICE.txt",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./build/lib/index.js",
  "types": "./build/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/lib/index.d.ts",
      "import": "./build/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "bump-gradle-version": "node scripts/gradle-version-update.mjs --package-version=${npm_package_version} && git add app/build.gradle",
    "build": "tsc -b",
    "build:apk": "./gradlew clean assembleDebug && npm run move-apks",
    "clean": "npm run build -- --clean",
    "lint:android": "./gradlew lint",
    "move-apks": "rm -rf apks && mkdir -p apks && cp app/build/outputs/apk/debug/settings_apk-debug.apk apks",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build:apk",
    "test": "node --enable-source-maps --test --test-timeout=60000 \"./build/test/unit/**/*.spec.js\"",
    "test:e2e": "node --enable-source-maps --test --test-force-exit --test-concurrency=1 --test-timeout=300000 \"./build/test/e2e/**/*.spec.js\"",
    "version": "npm run bump-gradle-version"
  },
  "dependencies": {
    "@appium/logger": "^2.0.0-rc.1",
    "asyncbox": "^6.0.1",
    "semver": "^7.5.4",
    "teen_process": "^4.0.4"
  },
  "devDependencies": {
    "@appium/tsconfig": "^1.2.0",
    "@appium/types": "^1.0.0-rc.1",
    "@types/node": "^26.0.0",
    "@types/sinon": "^22.0.0",
    "appium-adb": "^16.0.0",
    "sinon": "^22.0.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=10"
  }
}
