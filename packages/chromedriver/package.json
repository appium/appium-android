{
  "name": "appium-chromedriver",
  "version": "9.1.1",
  "description": "Node.js wrapper around chromedriver.",
  "keywords": [
    "android",
    "appium",
    "chrome"
  ],
  "homepage": "https://appium.io",
  "bugs": {
    "url": "https://github.com/appium/appium-android/issues"
  },
  "license": "Apache-2.0",
  "author": "Appium Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/appium/appium-android.git",
    "directory": "packages/chromedriver"
  },
  "directories": {
    "lib": "lib"
  },
  "files": [
    "config",
    "lib",
    "build/lib",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./build/lib/index.js",
  "types": "./build/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/lib/index.d.ts",
      "import": "./build/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "dev": "npm run build -- --watch",
    "prepare": "npm run build",
    "test": "node --enable-source-maps --experimental-test-module-mocks --test --test-force-exit --test-timeout=60000 \"./build/test/unit/**/*.spec.js\"",
    "test:e2e": "node --enable-source-maps --test --test-force-exit --test-concurrency=1 --test-timeout=600000 \"./build/test/functional/**/*.spec.js\""
  },
  "dependencies": {
    "@appium/base-driver": "^10.8.0",
    "@appium/support": "^7.2.6",
    "@xmldom/xmldom": "^0.x",
    "appium-adb": "^16.0.4",
    "asyncbox": "^6.4.3",
    "axios": "^1.20.0",
    "compare-versions": "^6.0.0",
    "semver": "^7.0.0",
    "teen_process": "^4.2.0",
    "xpath": "^0.x"
  },
  "devDependencies": {
    "@appium/tsconfig": "^1.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/semver": "^7.0.0",
    "@types/sinon": "^22.0.0",
    "sinon": "^22.0.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=10"
  }
}
